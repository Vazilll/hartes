# ==============================================================================
# vazus SuperGraph OS — Example Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Core System API Keys & Database Configuration
OPENCODE_GO_API_KEY="your-opencode-go-api-key"
JULES_API_KEY="your-jules-api-key"
GEMINI_API_KEY="your-gemini-api-key"
DNTS_DB_PATH="C:\\vazus\\services\\memory\\dnts.db"
SEARXNG_URL="http://localhost:8080"

# ------------------------------------------------------------------------------
# 🎓 РТУ МИРЭА (online-edu.mirea.ru) & 2FA Yandex Mail IMAP Credentials
# ------------------------------------------------------------------------------
# Учетные данные SSO Keycloak РТУ МИРЭА
MIREA_USERNAME="student_username"
MIREA_PASSWORD="student_password"

# Яндекс Почта для автоматического перехвата 2FA-кодов подтверждения (IMAP)
YANDEX_EMAIL="user@yandex.ru"
YANDEX_APP_PASSWORD="yandex-app-password"

# ------------------------------------------------------------------------------
# 🤖 LLM Engine Providers & API Configurations
# ------------------------------------------------------------------------------
# Provider selection: "ollama" (local) or "openai" / "deepseek" (cloud)
DNTS_LLM_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"

# DeepSeek / OpenAI API Keys
DEEPSEEK_API_KEY="your-deepseek-api-key"
OPENAI_API_KEY="your-openai-api-key"
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"

# ------------------------------------------------------------------------------
# 📊 Langfuse Observability & Tracing
# ------------------------------------------------------------------------------
LANGFUSE_PK="your-langfuse-public-key"
LANGFUSE_SK="your-langfuse-secret-key"
LANGFUSE_HOST="http://localhost:3000"

# ------------------------------------------------------------------------------
# 📱 Telegram Bot Integration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN="your-bot-token-from-@BotFather"
