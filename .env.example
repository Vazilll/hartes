# ==============================================================================
# Vazus SuperGraph OS — Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Core System & Database Configuration
# Default paths are automatically resolved by vazus_core.paths if omitted:
# VAZUS_ROOT="/app" (in Docker) or repository root
# VAZUS_DB_PATH="${VAZUS_ROOT}/services/memory/vazus.db"

# LLM Engine & Cloud API Keys
GEMINI_API_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
JULES_API_KEY=""

# Local LLM (Ollama)
# When running via Docker, use host.docker.internal to connect to Ollama on the host
OLLAMA_BASE_URL="http://host.docker.internal:11434"
OLLAMA_HOST="http://host.docker.internal:11434"
DNTS_LLM_PROVIDER="ollama"

# ------------------------------------------------------------------------------
# 🎓 РТУ МИРЭА (online-edu.mirea.ru) & 2FA Yandex Mail IMAP Credentials
# ------------------------------------------------------------------------------
# Учетные данные SSO Keycloak РТУ МИРЭА
MIREA_USERNAME=""
MIREA_PASSWORD=""

# Яндекс Почта для автоматического перехвата 2FA-кодов подтверждения (IMAP)
YANDEX_EMAIL=""
YANDEX_APP_PASSWORD=""

# ------------------------------------------------------------------------------
# 📱 Telegram Bot & Search Engine
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=""
SEARXNG_URL="http://localhost:8080"
SEARXNG_SECRET="vazus_secure_searxng_token_2026"
