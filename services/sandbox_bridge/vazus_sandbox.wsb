      <HostFolder>C:\vazus\services\sandbox_bridge</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\Vaz\AppData\Local\Programs</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\vazus</HostFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>C:\Users\Vaz\.gemini</HostFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
